# Copy to .env and fill in real values. .env is gitignored — never commit it.
# See docs/architecture.md for what each of these backs.

# ---- Agent Postgres (sessions, messages, tool_calls, pending_actions, audit_log) ----
POSTGRES_USER=ipam_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ipam_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ipam_agent:change-me@postgres:5432/ipam_agent

# ---- NetBox (IPAM system of record — its own Postgres/Redis, separate from above) ----
NETBOX_POSTGRES_USER=netbox
NETBOX_POSTGRES_PASSWORD=change-me
NETBOX_POSTGRES_DB=netbox
NETBOX_SECRET_KEY=generate-a-50-char-random-string-for-netbox-django-secret-key
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@example.com
NETBOX_SUPERUSER_PASSWORD=change-me

# What the Tool Layer uses to call NetBox's REST/GraphQL API (scoped service account token,
# not a personal credential — create this in NetBox under a dedicated API-only user).
NETBOX_URL=http://netbox:8080
NETBOX_TOKEN=replace-with-netbox-api-token

# ---- Ollama (local LLM) ----
OLLAMA_BASE_URL=http://ollama:11434
# Pick a tool-calling-capable model; test reliability against the actual tool schemas
# before committing (architecture doc section 4.4 / open decision in section 11).
OLLAMA_MODEL=llama3.1:8b

# ---- Auth (standalone JWT for now; see architecture doc section 11 re: SSO) ----
JWT_SECRET_KEY=generate-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- App behavior ----
ENVIRONMENT=development
LOG_LEVEL=INFO
AGENT_TOOL_STEP_LIMIT=8
AGENT_TURN_TIMEOUT_SECONDS=60

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
